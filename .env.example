# Copy to .env.local for local development. In production set these in Vercel → Environment Variables.

# --- Database (Neon, pooled connection string) ---
DATABASE_URL=

# --- Auth ---
# Generate with: npm run auth:hash-password
AUTH_PASSWORD_HASH=
# Production: dates.robertkebinger.com / https://dates.robertkebinger.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Providers ---
# Key from the dedicated Anthropic workspace "date-planner" (see docs/betrieb/kostenlimits.md)
ANTHROPIC_API_KEY=
# Key restricted to Places API (New)
GOOGLE_PLACES_API_KEY=
# DB API Marketplace application subscribed to "Timetables" (Free plan); empty = estimated train times
DB_CLIENT_ID=
DB_API_KEY=

# --- Cost limits (defaults shown; see docs/betrieb/kostenlimits.md) ---
AI_ENABLED=true
AI_MONTHLY_BUDGET_USD=15
AI_DAILY_BUDGET_USD=2
AI_MAX_TOOL_ITERATIONS=8
AI_MAX_WEB_SEARCHES_CHAT=3
AI_MAX_WEB_SEARCHES_GENERATE=5
AI_MAX_WEB_SEARCHES_TRIP=15
AI_MAX_API_CALLS_PER_DAY=200
AI_REQUEST_TIMEOUT_MS=90000
PLACES_PROVIDER=google
PLACES_DAILY_LIMIT=25
PLACES_MAX_LOOKUPS_PER_PLAN=6
PAID_CALLS_PER_MINUTE=20
